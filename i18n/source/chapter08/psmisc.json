    "Short Descriptions",
    "<a id=\"fuser\" name=\"fuser\"></a><span class=\"term\"><span class=\"command\"><strong>fuser</strong></span></span>",
    "Reports the Process IDs (PIDs) of processes that use the given files or file systems",
    "<a id=\"killall\" name=\"killall\"></a><span class=\"term\"><span class=\"command\"><strong>killall</strong></span></span>",
    "Kills processes by name; it sends a signal to all processes running any of the given commands",
    "<a id=\"peekfd\" name=\"peekfd\"></a><span class=\"term\"><span class=\"command\"><strong>peekfd</strong></span></span>",
    "Peek at file descriptors of a running process, given its PID",
